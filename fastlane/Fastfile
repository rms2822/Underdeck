default_platform(:ios)

# Builds the Capacitor-wrapped Underdeck iOS app and uploads it to
# TestFlight/App Store Connect. Runs entirely on a cloud macOS runner (see
# .github/workflows/ios-release.yml) — no local Mac required. See
# APPSTORE_SETUP.md for the one-time Apple/GitHub setup this lane expects.
platform :ios do
  desc "Archive and upload a build to TestFlight using an App Store Connect API key"
  lane :release do
    # ASC_KEY_CONTENT holds the raw text of the downloaded .p8 file, pasted
    # directly into the GitHub secret — no base64/encoding step required,
    # since that'd need a terminal the setup process assumes you don't have.
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: false
    )

    increment_build_number(
      xcodeproj: "ios/App/App.xcodeproj",
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
    )

    update_code_signing_settings(
      use_automatic_signing: true,
      path: "ios/App/App.xcodeproj",
      team_id: ENV["APPLE_TEAM_ID"],
      targets: ["App"]
    )

    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "Underdeck.ipa",
      export_options: {
        signingStyle: "automatic",
        teamID: ENV["APPLE_TEAM_ID"]
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
